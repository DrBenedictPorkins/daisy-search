DATABASE_URL=postgresql+asyncpg://daisy:daisy_dev@localhost:5432/daisy
DATABASE_URL_SYNC=postgresql+psycopg2://daisy:daisy_dev@localhost:5432/daisy
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO

# API keys
# ANTHROPIC_API_KEY=your-key-here

# LLM models (optional overrides)
# EXTRACTION_MODEL=claude-sonnet-4-6
# RESOLUTION_MODEL=claude-haiku-4-5
# TRIAGE_MODEL=claude-haiku-4-5

# Ollama (priority 1 for extraction — free, local)
# OLLAMA_URL=http://beefybox:11434
# OLLAMA_EXTRACTION_MODEL=mistral:7b

# Search backends (set at least one for discovery to work)
# BRAVE_SEARCH_API_KEY=your-key-here
# SEARXNG_URL=http://localhost:9741
# To start SearXNG: docker compose --profile searxng up -d

# Neo4j graph database
# NEO4J_URL=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=daisy_dev

# Web dashboard
# WEB_HOST=127.0.0.1
# WEB_PORT=8000

# Crawl4AI (optional — enables daisy_fetch_clean tool and /extract HTTP endpoint)
# CRAWL4AI_URL=http://localhost:11235
# CRAWL4AI_API_TOKEN=daisy-c4ai-token
