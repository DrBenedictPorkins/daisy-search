# ---------------------------------------------------------------------------
# Daisy Search — copy to .env and edit. Every value below is optional except
# the database URLs; the defaults match `docker compose up -d`.
# ---------------------------------------------------------------------------

# Database (async for the app, sync for Alembic)
DATABASE_URL=postgresql+asyncpg://daisy:daisy_dev@localhost:5432/daisy
DATABASE_URL_SYNC=postgresql+psycopg2://daisy:daisy_dev@localhost:5432/daisy

# Redis (only used by the optional batch queue)
REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO

# Extraction priority: Ollama > Anthropic API > return content to the agent.
# Set neither and the agent extracts facts in-context.

# Anthropic API (fallback extraction)
# ANTHROPIC_API_KEY=your-key-here

# LLM model overrides (aliases, never dated versions)
# EXTRACTION_MODEL=claude-sonnet-5-5
# RESOLUTION_MODEL=claude-haiku-5-5
# TRIAGE_MODEL=claude-haiku-5-5

# Ollama (priority 1 for extraction — free, local)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_EXTRACTION_MODEL=mistral:7b

# Search backends — set at least one, or daisy_search returns nothing
# SEARXNG_URL=http://localhost:9741
# BRAVE_SEARCH_API_KEY=your-key-here

# Neo4j identity graph (started by docker compose)
# NEO4J_URL=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=daisy_dev

# Crawl4AI — enables the daisy_fetch_clean tool and the /extract endpoint
# CRAWL4AI_URL=http://localhost:11235
# CRAWL4AI_API_TOKEN=daisy-c4ai-token

# Per-case workspace folders (git-ignored — they hold investigation data)
# PROJECTS_DIR=projects

# Read-only web dashboard
# WEB_HOST=127.0.0.1
# WEB_PORT=8000
